# --- Database (Neon Postgres) ---
# Pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Point Clerk's built-in redirects at the branded auth pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Storage (Cloudinary) ---
# Either set CLOUDINARY_URL, or the three discrete vars below.
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# --- Inngest (background story pipeline) ---
INNGEST_EVENT_KEY=""

# --- AI: story text (default Claude Haiku → OpenAI fallback) ---
ANTHROPIC_API_KEY=""
# Optional — overrides the default story-text model.
ANTHROPIC_TEXT_MODEL="claude-haiku-4-5"

# --- AI: chapter images (default BytePlus Seedream → DALL-E fallback) ---
BYTEPLUS_API_KEY=""
# Optional — ModelArk base + Seedream model id (confirm the id in the console).
BYTEPLUS_BASE_URL="https://ark.ap-southeast.bytepluses.com/api/v3"
BYTEPLUS_IMAGE_MODEL="seedream-4-0-250828"

# --- AI: OpenAI (fallback for both text and images) ---
OPENAI_API_KEY=""

# --- Cache / rate limiting (Upstash Redis) ---
# Optional. Unset = everything fails open (cache → Postgres, locks/limits allow).
# Provision via Vercel Marketplace (Storage → Upstash) or the Upstash console.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
